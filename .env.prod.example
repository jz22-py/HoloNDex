# Copy to .env.prod on the Droplet (never commit .env.prod).
# Used by: docker compose -f docker-compose.prod.yml

POSTGRES_DB=rosetta
POSTGRES_USER=rosetta_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password

SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://your-app.pages.dev
CSRF_TRUSTED_ORIGINS=https://your-app.pages.dev

# Overridden in compose to use host `db`; kept here for clarity
DATABASE_URL=postgres://rosetta_user:replace-with-a-strong-db-password@db:5432/rosetta

# Behind Cloudflare → origin HTTP is fine; Django still sees https via forwarded proto
SECURE_SSL_REDIRECT=True
PORT=8000
WEB_CONCURRENCY=2
